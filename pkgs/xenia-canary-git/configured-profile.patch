+bool ProfileManager::InitializeConfiguredProfile() {
+  if (cvars::profile_name.empty() && cvars::profile_xuid.empty()) {
+    return true;
+  }
+  uint64_t xuid = 0;
+  const auto& text = cvars::profile_xuid;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), xuid, 16);
+  if (!IsGamertagValid(cvars::profile_name) || text.size() != 16 ||
+      parsed.ec != std::errc() || parsed.ptr != text.data() + text.size() ||
+      !IsOfflineXUID(xuid)) {
+    XELOGE(
+        "Configured profile: profile_name must be a valid 1-15 character "
+        "gamertag and profile_xuid must be 16 hex digits starting with E "
+        "(local XUID)");
+    return false;
+  }
+
+  configured_xuid_ = xuid;
+  try {
+    const auto root = kernel_state_->emulator()->content_root() /
+                      fmt::format("{:016X}", xuid);
+    if (std::filesystem::exists(std::filesystem::symlink_status(root))) {
+      if (!LoadAccount(xuid)) {
+        XELOGE(
+            "Configured profile {:016X}: existing profile/account is missing "
+            "or corrupt; refusing to overwrite it",
+            xuid);
+        return false;
+      }
+    } else {
+      X_XAMACCOUNTINFO account = {};
+      string_util::copy_and_swap_truncating(account.gamertag,
+                                            xe::to_utf16(cvars::profile_name),
+                                            xe::countof(account.gamertag));
+      const bool created = CreateProfile(&account, xuid);
+      DismountProfile(xuid);
+      if (!created || !LoadAccount(xuid)) {
+        XELOGE(
+            "Configured profile {:016X}: could not create and verify native "
+            "account; check content_root permissions and free space",
+            xuid);
+        return false;
+      }
+    }
+  } catch (const std::filesystem::filesystem_error& error) {
+    XELOGE("Configured profile {:016X}: {}", xuid, error.what());
+    return false;
+  }
+
+  for (const auto other : FindProfiles()) {
+    if (other != xuid) LoadAccount(other);
+  }
+  // Slot 0 belongs to the configured profile, never to a stale native
+  // selection.
+  const std::string* slots[] = {&cvars::logged_profile_slot_1_xuid,
+                                &cvars::logged_profile_slot_2_xuid,
+                                &cvars::logged_profile_slot_3_xuid};
+  for (uint8_t slot = 1; slot < 4; ++slot) {
+    if (!slots[slot - 1]->empty()) {
+      const auto other =
+          xe::string_util::from_string<uint64_t>(*slots[slot - 1], true);
+      if (other != xuid) Login(other, slot, false);
+    }
+  }
+  if (cvars::profile_auto_login) {
+    Login(xuid, 0, false);
+    if (!GetProfile(uint8_t(0)) || GetProfile(uint8_t(0))->xuid() != xuid) {
+      XELOGE("Configured profile {:016X}: automatic login failed", xuid);
+      return false;
+    }
+  }
+  return true;
+}
