+
+bool ContentPackageDirectory::IsHeaderValid() const {
+  std::error_code error;
+  const auto status = std::filesystem::symlink_status(header_path_, error);
+  // Extracted profiles may have no header; present but unreadable ones fail.
+  return status.type() == std::filesystem::file_type::not_found ||
+         (!error && header_read_result_ == X_ERROR_SUCCESS &&
+          IsValidPackage() &&
+          header_.content_metadata.content_type == XContentType::kProfile &&
+          header_.content_metadata.execution_info.title_id == kDashboardID);
+}

