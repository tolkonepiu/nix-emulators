diff --git a/src/Ryujinx/Program.cs b/src/Ryujinx/Program.cs
--- a/src/Ryujinx/Program.cs
+++ b/src/Ryujinx/Program.cs
@@ -51,2 +51,17 @@ namespace Ryujinx.Ava
         {
+            if (args.Length > 0 && args[0] == "--dump-default-config")
+            {
+                if (args.Length != 2 || !Path.IsPathFullyQualified(args[1]))
+                {
+                    Console.Error.WriteLine("Usage: --dump-default-config <absolute-output-file>");
+                    return 1;
+                }
+
+                // Export upstream defaults without user-data initialization or GPU probing.
+                ConfigurationState.Initialize();
+                ConfigurationState.Instance.LoadDefault(detectGraphicsBackend: false);
+                ConfigurationState.Instance.ToFileFormat().SaveConfig(args[1]);
+                return 0;
+            }
+
             Version = ReleaseInformation.Version;
diff --git a/src/Ryujinx/Systems/Configuration/ConfigurationState.cs b/src/Ryujinx/Systems/Configuration/ConfigurationState.cs
--- a/src/Ryujinx/Systems/Configuration/ConfigurationState.cs
+++ b/src/Ryujinx/Systems/Configuration/ConfigurationState.cs
@@ -167,4 +167,4 @@ namespace Ryujinx.Ava.Systems.Configuration
