-	std::mutex s_cafeStaticDataMutex;
+	struct StaticDataRegistry
+	{
+		std::unique_ptr<VHeap> heap;
+		std::set<CafeStaticData*> blocks;
+		std::mutex mutex;
+	};
+
+	StaticDataRegistry& GetStaticDataRegistry()
+	{
+		// Cross-TU static destructors need the registry and mutex until process exit.
+		static auto* registry = new StaticDataRegistry;
+		return *registry;
+	}
 }
 
